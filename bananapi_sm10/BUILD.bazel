    makefile = "//common:Makefile",
    module_outs = get_gki_modules_list("riscv64") +
                  get_kunit_modules_list("riscv64") +
                  SPACEMIT_K3_BUILT_MODULES,
    pre_defconfig_fragments = [
        "//devices/spacemit/bananapi_f3:spacemit_k1x.fragment",
