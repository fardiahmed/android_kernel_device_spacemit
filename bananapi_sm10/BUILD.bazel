# Kernel images and base files from kernel_build
pkg_files(
    name = "spacemit_k3_pkg_files",
    srcs = [":spacemit_k3"],
    strip_prefix = strip_prefix.files_only(),
)

# ============================================================
# Genrules to extract individual modules from kernel_build outputs
# Outputs individual .ko files directly (no tar archives)
# so pkg_install copies them as-is to the dist directory
# ============================================================

# Extract vendor boot modules (essential for first stage init)
genrule(
    name = "spacemit_k3_vendor_boot_modules_filtered",
    srcs = [":spacemit_k3"],
    outs = ["ramdisk_ko/" + mod for mod in SPACEMIT_K3_VENDOR_BOOT_MODULES],
    cmd = """
        declare -A MODMAP
        for f in $(SRCS); do
            b=$$(basename "$$f")
            [[ "$$b" == *.ko ]] && MODMAP["$$b"]="$$f"
        done
        for out in $(OUTS); do
            modname=$$(basename "$$out")
            src="$${MODMAP[$$modname]:-}"
            if [ -n "$$src" ]; then
                cp "$$src" "$$out"
            else
                echo "ERROR: Module $$modname not found in kernel build" >&2
                exit 1
            fi
        done
    """,
)

# Extract vendor DLKM modules (loaded after boot from eMMC)
genrule(
    name = "spacemit_k3_vendor_dlkm_modules_filtered",
    srcs = [":spacemit_k3"],
    outs = ["vendor_dlkm_ko/" + mod for mod in SPACEMIT_K3_VENDOR_DLKM_MODULES],
    cmd = """
        declare -A MODMAP
        for f in $(SRCS); do
            b=$$(basename "$$f")
            [[ "$$b" == *.ko ]] && MODMAP["$$b"]="$$f"
        done
        for out in $(OUTS); do
            modname=$$(basename "$$out")
            src="$${MODMAP[$$modname]:-}"
            if [ -n "$$src" ]; then
                cp "$$src" "$$out"
            else
                echo "ERROR: Module $$modname not found in kernel build" >&2
                exit 1
            fi
        done
    """,
)

# Extract system DLKM modules (GKI modules)
genrule(
    name = "spacemit_k3_system_dlkm_modules_filtered",
    srcs = [":spacemit_k3"],
    outs = ["system_dlkm_ko/" + mod.split("/")[-1] for mod in SPACEMIT_GKI_MODULES],
    cmd = """
        declare -A MODMAP
        for f in $(SRCS); do
            b=$$(basename "$$f")
            [[ "$$b" == *.ko ]] && MODMAP["$$b"]="$$f"
        done
        for out in $(OUTS); do
            modname=$$(basename "$$out")
            src="$${MODMAP[$$modname]:-}"
            if [ -n "$$src" ]; then
                cp "$$src" "$$out"
            else
                echo "ERROR: Module $$modname not found in kernel build" >&2
                exit 1
            fi
        done
    """,
)

# Package individual .ko files for distribution
pkg_files(
    name = "spacemit_k3_vendor_boot_modules_pkg_files",
    srcs = [":spacemit_k3_vendor_boot_modules_filtered"],
    prefix = "ramdisk",
    strip_prefix = strip_prefix.files_only(),
)

