        "Image.gz",
        "System.map",
        "modules.builtin",
        "modules.builtin.modinfo",
        "vmlinux",
        "vmlinux.symvers",
        "arch/riscv/boot/dts/spacemit/k3-bananapi-sm10.dtb",
        "arch/riscv/boot/dts/spacemit/k3-pico-itx.dtb",
    ],
    arch = "riscv64",
    ddk_module_headers = ["//common:all_headers_riscv64"],
    defconfig = "//common:arch/riscv/configs/gki_defconfig",
    make_goals = [
        "Image",
        "Image.gz",
        "modules",
        "spacemit/k3-bananapi-sm10.dtb",
        "spacemit/k3-pico-itx.dtb",
