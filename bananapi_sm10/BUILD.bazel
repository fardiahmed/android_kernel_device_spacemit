# ============================================================
# Vendor Boot modules (first stage init: UFS/eMMC, display, USB for recovery/fastbootd).
# Order matters (modules.load): same constraints as the K1 (CCU core first).
# ============================================================
SPACEMIT_K3_VENDOR_BOOT_MODULES = [
    # Clocks: CCU core before the K3 driver (same split as the K1)
    "spacemit-ccu.ko",
    "spacemit-ccu-k3.ko",
    # Resets
    "reset-spacemit-common.ko",
    "reset-spacemit-k3.ko",
    # RPMI mailbox + power domains (UFS, display, GPU, VPU domains are served by the K3 PMU)
    "k3-mailbox.ko",
    "k3-pm_domain.ko",
    # GPIO; pinctrl is builtin (=y)
    "gpio-spacemit-k1.ko",
    # I2C + P1 PMIC (regulators, RTC, power key, reboot) -- the K3 reference board has a P1
    "i2c-k1.ko",
    "simple-mfd-i2c.ko",
    "spacemit-p1.ko",
    "rtc-spacemit-p1.ko",
    "spacemit-p1-reboot.ko",
    "spacemit-p1-pwrkey.ko",
    # Boot storage: UFS (K3-CoM260) and eMMC/SD
    "ufs-spacemit.ko",
    "sdhci-of-k1.ko",
    # Display early for SurfaceFlinger/bootanim (K3 saturn-hee DPU + Innosilicon eDP/DP)
    "drm_dma_helper.ko",
    "drm_client_lib.ko",
    "drm_display_helper.ko",
    "drm_dp_aux_bus.ko",
    "spacemit-drm-k3.ko",
    "spacemit_inno_dp.ko",
    # USB (recovery/fastbootd have no vendor_dlkm): USB3 PHY for the dwc3 DRD (dwc3 builtin), Type-C
    "phy-k3-usb3.ko",
    "fusb301.ko",
    "onboard_usb_dev.ko",
]

