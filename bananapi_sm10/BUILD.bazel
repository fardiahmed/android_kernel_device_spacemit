    srcs = [":spacemit_k3_initramfs"],
    prefix = "initramfs",
    strip_prefix = strip_prefix.files_only(),
)

# Module lists (for Android to organize modules)
pkg_files(
    name = "spacemit_k3_module_lists_pkg_files",
    srcs = [
        ":spacemit_k3_system_dlkm_modules_list",
        ":spacemit_k3_vendor_dlkm_modules_list",
        ":spacemit_k3_vendor_boot_modules_list",
    ],
    strip_prefix = strip_prefix.files_only(),
)

# Modules install (all modules at root - flat)
pkg_files(
    name = "spacemit_k3_modules_pkg_files",
    srcs = [":spacemit_k3_modules_install"],
    strip_prefix = strip_prefix.files_only(),
)

# ============================================================
# Distribution target
# ============================================================
pkg_install(
    name = "spacemit_k3_dist",
    srcs = [
        # Kernel images and all modules at root
        ":spacemit_k3_pkg_files",
        ":spacemit_k3_modules_pkg_files",
        # Actual .ko files in directories (like TI)
        ":spacemit_k3_vendor_boot_modules_pkg_files",
        ":spacemit_k3_vendor_dlkm_modules_pkg_files",
        ":spacemit_k3_system_dlkm_modules_pkg_files",
        # Images
        ":spacemit_k3_vendor_dlkm_image_pkg_files",
        ":spacemit_k3_initramfs_pkg_files",
        # Module lists
        ":spacemit_k3_module_lists_pkg_files",
    ],
    destdir = "out/spacemit_k3/dist",
)
